{
  "name": "oreneta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "bun ../scripts/i18n/catalog.ts generate",
    "dev": "vite",
    "prebuild": "bun ../scripts/i18n/catalog.ts generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "test:bundler": "node --test build-tests/*.check.mjs",
    "startup:verify": "bun run build && playwright test --config e2e/playwright.config.ts",
    "baseline:serve": "vite --config baseline/vite.config.ts",
    "baseline:verify": "playwright test --config baseline/playwright.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@legendapp/state": "3.0.0-beta.47",
    "@tiptap/extension-image": "3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "intl-messageformat": "^11.2.8",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@happy-dom/global-registrator": "^20.11.2",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.11"
  }
}
